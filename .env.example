# Zmienne środowiskowe aplikacji w chmurze (wzór – prawdziwe wartości trzymamy w Azure Key Vault,
# nie w repozytorium). Lokalnie nic nie trzeba ustawiać.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<losowy-ciag-min-50-znakow>
DJANGO_ALLOWED_HOSTS=owoce.example.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://owoce.example.pl
DATABASE_URL=postgres://owoce_app:<haslo>@<serwer>.postgres.database.azure.com:5432/owoce?sslmode=require
AZURE_ACCOUNT_NAME=<konto-storage>
AZURE_ACCOUNT_KEY=<klucz>
AZURE_CONTAINER=media
GUNICORN_WORKERS=3
