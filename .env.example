# Zmienne środowiskowe aplikacji w chmurze (wzór – prawdziwe wartości są w sekretach Azure,
# nie w repozytorium). Lokalnie nic nie trzeba ustawiać. W Azure ustawiają je skrypty deploy/azure/.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<losowy-ciag-min-50-znakow>
DJANGO_ALLOWED_HOSTS=owoce.example.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://owoce.example.pl
DATABASE_URL=postgres://owoce_app:<haslo>@<serwer>.postgres.database.azure.com:5432/owoce?sslmode=require
AZURE_ACCOUNT_NAME=<konto-storage>
# Opcjonalnie. Bez klucza aplikacja loguje się do Storage tożsamością zarządzaną (tak działa wdrożenie w Container Apps).
AZURE_ACCOUNT_KEY=<klucz>
AZURE_CONTAINER=media
GUNICORN_WORKERS=3
# E-maile (potwierdzenie adresu po rejestracji, reset hasła). Bez EMAIL_HOST wiadomość ląduje tylko w logach aplikacji.
EMAIL_HOST=serwerXXXXXX.home.pl
EMAIL_PORT=465
EMAIL_HOST_USER=kontakt@owocownik.pl
EMAIL_HOST_PASSWORD=<haslo-smtp>
DJANGO_DEFAULT_FROM_EMAIL=Owocownik <kontakt@owocownik.pl>
